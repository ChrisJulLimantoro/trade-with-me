DATABASE_URL=postgresql+asyncpg://ats:ats@localhost:5432/ats
X_BEARER_TOKEN=
LOG_LEVEL=INFO
LOG_RENDER=rich
SEED=42

# LLM-plan trading layer (POC). Leave LLM_MOCK=true to run with no key / no token spend.
LLM_MOCK=true
OPENAI_API_KEY=

# Binance Futures TESTNET execution (opt-in; `ats engine run --live-execute`).
# TESTNET ONLY — generate keys at https://testnet.binancefuture.com. Leave blank for the
# default paper-only system. BINANCE_TESTNET must stay true; mainnet is not supported.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
# Optional: override the testnet REST base if your demo account is on the newer host.
# Must include the /fapi suffix, e.g. https://demo-fapi.binance.com/fapi
# Leave blank to use the python-binance default (https://testnet.binancefuture.com/fapi).
BINANCE_FUTURES_URL=
